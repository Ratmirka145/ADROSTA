# Runtime
APP_ENV=development
DEBUG=true
API_DOCS_ENABLED=true
LOG_LEVEL=INFO

# SQLite. Use an absolute path on a persistent volume in production.
DATABASE_PATH=./data/adrosta.sqlite3
SQLITE_BUSY_TIMEOUT_MS=5000

# Exact comma-separated origins/hosts; never use an asterisk.
CORS_ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_PROXY_IPS=

# Generate a private value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_HASH_SECRET=
IDEMPOTENCY_TTL_SECONDS=86400
DUPLICATE_WINDOW_SECONDS=300
IDEMPOTENCY_KEY_MAX_LENGTH=128

# Abuse and payload limits
ORDER_RATE_LIMIT_COUNT=5
ORDER_RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=65536
MAX_ORDER_ITEMS=100
MAX_BOXES_PER_ITEM=10000
MAX_TOTAL_BOXES=20000

# Optional generic server-to-server webhook. Values stay on the backend.
WEBHOOK_ENABLED=false
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_TOKEN=
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_SECONDS=5

# Durable SQLite outbox. Run `python -m app.worker` when webhook is enabled.
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_BATCH_SIZE=20
OUTBOX_LOCK_SECONDS=60
# Development defaults to store-only. In production, set this to true only
# after consciously choosing SQLite without an external recipient.
# ALLOW_STORE_ONLY=true
